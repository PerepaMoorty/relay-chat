# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me
HOST=0.0.0.0
PORT=5000
# 1 turns on the Flask debugger; keep 0 for demos
DEBUG=0
# The SQLite file is created under instance/
DATABASE_URL=sqlite:///relay.db
# Extra origins allowed to open a socket, comma-separated. Leave empty: same-origin works on any address.
CORS_ORIGINS=
